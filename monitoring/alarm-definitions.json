{
  "alarms": [
    {
      "name": "starttech-alb-5xx-high",
      "description": "Fires when the backend returns more than 10 server errors per minute",
      "metric": "HTTPCode_Target_5XX_Count",
      "namespace": "AWS/ApplicationELB",
      "threshold": 10,
      "comparison": "GreaterThanThreshold",
      "evaluation_periods": 2,
      "period_seconds": 60,
      "action": "send SNS email alert"
    },
    {
      "name": "starttech-alb-latency-high",
      "description": "Fires when p99 response time exceeds 3 seconds",
      "metric": "TargetResponseTime",
      "namespace": "AWS/ApplicationELB",
      "threshold": 3,
      "comparison": "GreaterThanThreshold",
      "evaluation_periods": 2,
      "period_seconds": 60,
      "action": "send SNS email alert"
    },
    {
      "name": "starttech-high-cpu",
      "description": "Triggers Auto Scaling to add an EC2 instance when CPU > 70%",
      "metric": "CPUUtilization",
      "namespace": "AWS/EC2",
      "threshold": 70,
      "comparison": "GreaterThanThreshold",
      "evaluation_periods": 2,
      "period_seconds": 120,
      "action": "trigger scale-out auto scaling policy"
    },
    {
      "name": "starttech-low-cpu",
      "description": "Triggers Auto Scaling to remove an EC2 instance when CPU < 30%",
      "metric": "CPUUtilization",
      "namespace": "AWS/EC2",
      "threshold": 30,
      "comparison": "LessThanThreshold",
      "evaluation_periods": 2,
      "period_seconds": 120,
      "action": "trigger scale-in auto scaling policy"
    }
  ]
}
