# -------------------------------------------------
# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in
# your real values. NEVER commit terraform.tfvars.
# -------------------------------------------------

aws_region   = "us-east-1"
project_name = "starttech"
environment  = "prod"

# Find the latest Amazon Linux 2 AMI ID in the AWS Console:
# EC2 → AMIs → search "Amazon Linux 2" (community AMIs)
ami_id        = "ami-0c02fb55956c7d316"
instance_type = "t3.micro"

# Docker image pushed to Docker Hub or ECR
docker_image = "your-dockerhub-username/much-to-do-backend:latest"

# MongoDB Atlas connection string (never commit this value!)
mongo_uri = "mongodb+srv://user:password@cluster.mongodb.net/muchToDo"

# S3 bucket names must be globally unique across all AWS accounts
frontend_bucket_name = "starttech-frontend-prod-your-unique-suffix"

# Email to receive CloudWatch alarm notifications
alert_email = "devops@yourcompany.com"
